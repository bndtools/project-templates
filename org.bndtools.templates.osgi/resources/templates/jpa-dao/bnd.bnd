-buildpath: \
	osgi.annotation; version=8.1.0,\
	osgi.core; version=8.0.0,\
	org.osgi.service.component.annotations; version=1.5.1,\
	org.osgi.service.jpa; version=1.1.1,\
	org.osgi.service.transaction.control; version=1.0.0,\
	org.apache.aries.jpa.javax.persistence_2.1;version=2.7.3

-testpath: \
	\${junit},\
	\${mockito},\
	\${mockito-deps}

$if(javaLevel)$
javac.source: $javaLevel$
javac.target: $javaLevel$
$endif$

Bundle-Version: 0.0.0.\${tstamp}

-includeresource: resources

-privatepackage $basePackageName$.*