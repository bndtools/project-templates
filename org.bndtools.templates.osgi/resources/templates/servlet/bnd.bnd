-buildpath: \
	osgi.annotation; version=8.1.0,\
	osgi.core; version=8.0.0,\
	org.osgi.service.component.annotations; version=1.5.1,\
	org.osgi.service.servlet; version=2.0.0,\
	org.apache.felix.http.servlet-api; version=6.1.0

-testpath: \
	\${junit},\
	\${mockito},\
	\${mockito-deps}

$if(javaLevel)$
javac.source: $javaLevel$
javac.target: $javaLevel$
$endif$

Bundle-Version: 0.0.0.\${tstamp}